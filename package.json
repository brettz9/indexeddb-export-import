{
  "name": "idb-export-import",
  "version": "3.0.0",
  "description": "Export/import an IndexedDB database to/from Typeson JSON",
  "type": "module",
  "exports": {
    "types": "./index.d.ts",
    "import": "./index.js"
  },
  "scripts": {
    "prepublishOnly": "pnpm tsc && pnpm build && pnpm attw",
    "attw": "attw --pack . --profile esm-only node16",
    "tsc": "tsc",
    "tsc-prod": "tsc -p tsconfig-prod.json",
    "build": "pnpm tsc-prod",
    "test": "c8 mocha",
    "lint": "eslint . --ext .js"
  },
  "c8": {
    "checkCoverage": true,
    "lines": 100,
    "branches": 100,
    "statements": 100,
    "functions": 100,
    "reporter": [
      "lcov",
      "text"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brettz9/indexeddb-export-import.git"
  },
  "keywords": [
    "IndexedDB",
    "JSON",
    "import",
    "export",
    "serialize",
    "deserialize",
    "backup",
    "restore"
  ],
  "author": "Justin Emery",
  "contributors": [
    "Brett Zamir"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brettz9/indexeddb-export-import/issues"
  },
  "homepage": "https://github.com/brettz9/indexeddb-export-import#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "dexie": "^4.4.6",
    "eslint": "^10.12.0",
    "eslint-config-ash-nazg": "^43.2.3",
    "fake-indexeddb": "^6.2.5",
    "mocha": "^12.0.3",
    "rollup": "^4.64.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "dependencies": {
    "typeson-registry": "^15.2.0"
  }
}
